# Local secrets for agentic-RAG (COPY to .env and fill in). .env is gitignored.
#
# The app calls Google's OpenAI-compatible endpoint, so a GEMINI AI STUDIO key
# works directly. Put it in GEMINI_API_KEY. ANTHROPIC_AUTH_TOKEN is an optional
# fallback if you instead point PROXY_BASE_URL back at the class proxy.

# Gemini AI Studio key (primary).
GEMINI_API_KEY=

# Google OpenAI-compatible base (default; override PROXY_BASE_URL for class proxy).
PROXY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Models as exposed by Google AI Studio (OpenAI-compatible).
# IMPORTANT: use the exact id from /v1/models. The bare `gemma-4-26b-it` and
# `text-embedding-004/005` are NOT served there and return 404 — which is what
# previously made every faithfulness/relevancy check come back FAIL.
RAG_LLM_MODEL=models/gemma-4-26b-a4b-it
RAG_EMBEDDING_MODEL=models/gemini-embedding-001

# ---- OpenRouter (optional, raises rate limits) ----
# Set OPENROUTER_API_KEY to unlock the OpenRouter provider for embeddings and
# reranking. Then switch EMBEDDING_PROVIDER / RERANKER_PROVIDER to "openrouter"
# (here, or live in the Settings UI) to escape the Gemini free-tier limits.
OPENROUTER_API_KEY=
# Provider selection (gemini | openrouter). Can also be changed at runtime in
# the Settings UI (persisted to the DB), but these are the boot defaults.
EMBEDDING_PROVIDER=gemini
RERANKER_PROVIDER=gemini

# Class-proxy fallback (only if you switch PROXY_BASE_URL back).
ANTHROPIC_AUTH_TOKEN=

# Session signing key. REQUIRED in production — without it the app falls back
# to the hardcoded "dev-session-secret", and anyone who knows that default can
# forge a session cookie for ANY user id. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Check GET /api/health -> auth.session_secret_is_default to confirm a deploy
# is not running on the fallback.
SESSION_SECRET=

# Google OAuth (optional).
# GOOGLE_REDIRECT_URI is NOT derived from the request — set it whenever
# GOOGLE_CLIENT_ID is set, matching the console entry character for character,
# e.g. https://<your-app>.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Where folder sources are allowed to live.
RAG_ALLOWED_ROOT=C:/Users/gelwu

# Vector store backend: "chroma" (local disk) or "neon" (Postgres+pgvector).
VECTOR_BACKEND=chroma
# Neon Postgres connection string (only used when VECTOR_BACKEND=neon). On
# Vercel this is injected by the Neon integration as DATABASE_URL.
PG_DATABASE_URL=
